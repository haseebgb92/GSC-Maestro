# Optional remote MCP/OAuth deployment. Do NOT store real credentials in Git.
# Local desktop Google/Bing/Yandex credentials are entered in the app.
# Enable only if exposing the MCP through your own authenticated HTTPS reverse proxy.
GSC_MAESTRO_PUBLIC_BASE_URL=https://your-domain.example/gsc-maestro
GSC_MAESTRO_HTTP_PORT=8798
# GSC_MAESTRO_DB=/home/YOUR_USER/.local/share/com.advertpreneur.gscmaestro/maestro.sqlite3
# GSC_MAESTRO_TOKEN_FILE=/home/YOUR_USER/.local/share/com.advertpreneur.gscmaestro/mcp-http-token
