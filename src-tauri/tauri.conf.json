{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GSC Maestro",
  "version": "1.0.0",
  "identifier": "com.advertpreneur.gscmaestro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5179",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GSC Maestro",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "shortDescription": "Independent search intelligence dashboard for Advertpreneur",
    "resources": [
      "resources/gsc-maestro-mcp.mjs",
      "resources/maestro-overview.html",
      "resources/gsc-maestro-http.mjs",
      "resources/icon.png",
      "resources/gsc-maestro-crawl.mjs",
      "resources/gsc-maestro-bing.mjs",
      "resources/gsc-maestro-yandex.mjs"
    ]
  }
}
